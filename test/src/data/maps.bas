Sub mapDraw(screen as Ubyte)
    Dim index, base As Uinteger
    Dim y, x As Ubyte

    x = 0
    y = 0

    base = @map(screen, 0)

    For index=0 To SCREEN_LENGTH - 1
        drawTile(Peek(base + index), x, y)

        x = x + 1
        If x = SCREEN_WIDTH Then
            x = 0
            y = y + 1
        End If
    Next index
End Sub

' Example of map drawing with putChars and paintData
' You can rewrite as you want
Sub drawTile(tile As Ubyte, x As Ubyte, y As Ubyte)
    putChars(x, y, 1, 1, @tiles(tile, 0))
    paintData(x, y, 1, 1, @tilesAttr(tile, 0))
End Sub
