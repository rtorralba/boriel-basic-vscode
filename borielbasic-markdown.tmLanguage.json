{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Boriel Basic Markdown Injection",
    "fileTypes": [],
    "injectionSelector": "L:text.html.markdown",
    "patterns": [
        {
            "begin": "(?x)(^|\\G)(\\s*)(`{3,})(\\s*(?i:borielbasic|boriel-basic|boriel_basic|zxbas)\\s*)$",
            "name": "markup.fenced_code.block.markdown",
            "end": "(^|\\G)(\\2)(`{3,})\\s*$",
            "beginCaptures": {
                "3": { "name": "punctuation.definition.markdown" },
                "4": { "name": "fenced_code.block.language" }
            },
            "endCaptures": {
                "3": { "name": "punctuation.definition.markdown" }
            },
            "patterns": [
                {
                    "begin": "(^|\\G)(\\s*)((?!`{3,}))",
                    "while": "(^|\\G)(?!(\\s*)(`{3,})\\s*$)",
                    "contentName": "meta.embedded.block.borielbasic",
                    "patterns": [
                        { "include": "source.borielbasic" }
                    ]
                }
            ]
        }
    ],
    "scopeName": "markdown.borielbasic.codeblock"
}
