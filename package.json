{
    "homepage": "https://github.com/rtorralba/boriel-basic-vscode/blob/main/README.md",
    "name": "boriel-basic",
    "displayName": "Boriel Basic",
    "description": "Programming language support for Boriel Basic, a BASIC compiler for the ZX Spectrum.",
    "version": "1.0.40",
    "author": "Raül Torralba (Juntelart)",
    "license": "AGPL-3.0",
    "publisher": "rtorralba",
    "repository": {
        "type": "git",
        "url": "https://github.com/rtorralba/boriel-basic-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/rtorralba/boriel-basic-vscode/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:borielbasic",
        "onDebugResolve:borielbasic",
        "onDebugInitialConfigurations",
        "onCommand:borielBasic.updateZXP2Boriel",
        "onCommand:borielBasic.runTurbo80",
        "onCommand:borielBasic.debugTurbo80"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "borielbasic",
                "aliases": [
                    "Boriel Basic",
                    "boriel-basic"
                ],
                "extensions": [
                    ".bas",
                    ".zxbas"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "borielbasic",
                "scopeName": "source.borielbasic",
                "path": "./borielbasic.tmLanguage.json"
            },
            {
                "path": "./borielbasic-markdown.tmLanguage.json",
                "scopeName": "markdown.borielbasic.codeblock",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.borielbasic": "borielbasic"
                }
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Boriel Basic Configuration",
            "properties": {
                "borielBasic.mainFile": {
                    "type": "string",
                    "default": "main.bas",
                    "description": "Archivo principal del proyecto a compilar."
                },
                "borielBasic.optimizeLevel": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 4,
                    "description": "Nivel de optimización (0-4)."
                },
                "borielBasic.outputFormat": {
                    "type": "string",
                    "default": "tap",
                    "enum": [
                        "tap",
                        "tzx"
                    ],
                    "description": "Formato de salida (tap o tzx)."
                },
                "borielBasic.autorun": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ejecutar automáticamente el programa después de compilar."
                },
                "borielBasic.org": {
                    "type": "integer",
                    "default": 32768,
                    "description": "Dirección ORG (inicio del código máquina)."
                },
                "borielBasic.includeBasicLoader": {
                    "type": "boolean",
                    "default": true,
                    "description": "Incluir el cargador BASIC en el programa."
                },
                "borielBasic.heapSize": {
                    "type": "integer",
                    "default": 4768,
                    "description": "Tamaño del HEAP en bytes."
                },
                "borielBasic.formatKeywords": {
                    "type": "boolean",
                    "default": false,
                    "description": "Si está activado, las palabras clave se formatearán"
                },
                "borielBasic.defaultEmulator": {
                    "type": "string",
                    "default": "turbo80",
                    "enum": [
                        "turbo80",
                        "zesarux"
                    ],
                    "description": "Emulador por defecto para ejecutar y depurar programas Boriel Basic (turbo80 o zesarux)."
                },
                "borielBasic.turbo80Model": {
                    "type": "string",
                    "default": "128k",
                    "enum": [
                        "128k",
                        "48k",
                        "plus2",
                        "plus2a",
                        "plus3",
                        "16k"
                    ],
                    "enumDescriptions": [
                        "ZX Spectrum 128K (Sonido AY-3-8912, 128KB RAM - Por defecto)",
                        "ZX Spectrum 48K (Estándar original Sinclair, 48KB RAM)",
                        "ZX Spectrum +2 (Modelo gris con cassette)",
                        "ZX Spectrum +2A (Modelo negro Amstrad)",
                        "ZX Spectrum +3 (Modelo con disquetera)",
                        "ZX Spectrum 16K (Modelo básico de 16KB)"
                    ],
                    "description": "Modelo de máquina ZX Spectrum para Turbo80 (por defecto 128k)."
                },
                "borielBasic.turbo80Crt": {
                    "type": "boolean",
                    "default": true,
                    "description": "Activar simulación CRT (scanlines y fósforo) en el emulador Turbo80."
                },
                "borielBasic.zesaruxPath": {
                    "type": "string",
                    "default": "zesarux",
                    "description": "Ruta al ejecutable de ZEsarUX."
                },
                "borielBasic.zesaruxRemoteDebugPort": {
                    "type": "integer",
                    "default": 10000,
                    "description": "Puerto para el protocolo de depuración remota de ZEsarUX."
                }
            }
        },
        "commands": [
            {
                "command": "borielBasic.compileAndRun",
                "title": "Compilar y Ejecutar",
                "category": "Boriel Basic"
            },
            {
                "command": "borielBasic.runTurbo80",
                "title": "Ejecutar en Turbo80 (Webview)",
                "category": "Boriel Basic",
                "icon": "$(play)"
            },
            {
                "command": "borielBasic.debugTurbo80",
                "title": "Depurar en Turbo80 (Webview)",
                "category": "Boriel Basic",
                "icon": "$(debug-alt)"
            },
            {
                "command": "borielBasic.compile",
                "title": "Compilar Boriel Basic",
                "category": "Boriel Basic"
            },
            {
                "command": "borielBasic.debugContinue",
                "title": "Depuración: Continuar",
                "category": "Boriel Basic",
                "icon": "$(debug-continue)"
            },
            {
                "command": "borielBasic.debugPause",
                "title": "Depuración: Pausar",
                "category": "Boriel Basic",
                "icon": "$(debug-pause)"
            },
            {
                "command": "borielBasic.debugStepOver",
                "title": "Depuración: Paso por encima",
                "category": "Boriel Basic",
                "icon": "$(debug-step-over)"
            },
            {
                "command": "borielBasic.debugStepInto",
                "title": "Depuración: Paso a paso",
                "category": "Boriel Basic",
                "icon": "$(debug-step-into)"
            },
            {
                "command": "borielBasic.debugStepOut",
                "title": "Depuración: Paso hacia afuera",
                "category": "Boriel Basic",
                "icon": "$(debug-step-out)"
            },
            {
                "command": "borielBasic.debugStop",
                "title": "Depuración: Detener",
                "category": "Boriel Basic",
                "icon": "$(debug-stop)"
            },
            {
                "command": "borielBasic.updateLSP",
                "title": "Actualizar Boriel Basic LSP",
                "category": "Boriel Basic"
            },
            {
                "command": "borielBasic.exportZXPToBoriel",
                "title": "Export to Boriel Basic",
                "category": "Boriel Basic"
            },
            {
                "command": "borielBasic.updateZXP2Boriel",
                "title": "Actualizar zxp2boriel (binario)",
                "category": "Boriel Basic"
            },
            {
                "command": "borielBasic.selectTurbo80Model",
                "title": "Seleccionar Modelo de ZX Spectrum (Turbo80)",
                "category": "Boriel Basic"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "borielBasic.runTurbo80",
                    "when": "editorLangId == borielbasic",
                    "group": "navigation@1"
                },
                {
                    "command": "borielBasic.debugTurbo80",
                    "when": "editorLangId == borielbasic",
                    "group": "navigation@2"
                }
            ],
            "explorer/context": [
                {
                    "when": "resourceExtname == .zxp",
                    "command": "borielBasic.exportZXPToBoriel",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "borielBasic.runTurbo80",
                "key": "ctrl+f5",
                "mac": "cmd+f5",
                "when": "editorTextFocus && (editorLangId == borielbasic)"
            },
            {
                "command": "borielBasic.debugTurbo80",
                "key": "f5",
                "mac": "f5",
                "when": "editorTextFocus && (editorLangId == borielbasic) && !borielBasic.isDebugging"
            },
            {
                "command": "borielBasic.debugContinue",
                "key": "f5",
                "mac": "f5",
                "when": "borielBasic.isDebugging"
            },
            {
                "command": "borielBasic.debugPause",
                "key": "f6",
                "mac": "f6",
                "when": "borielBasic.isDebugging"
            },
            {
                "command": "borielBasic.debugStepOver",
                "key": "f10",
                "mac": "f10",
                "when": "borielBasic.isDebugging"
            },
            {
                "command": "borielBasic.debugStepInto",
                "key": "f11",
                "mac": "f11",
                "when": "borielBasic.isDebugging"
            },
            {
                "command": "borielBasic.debugStepOut",
                "key": "shift+f11",
                "mac": "shift+f11",
                "when": "borielBasic.isDebugging"
            },
            {
                "command": "borielBasic.debugStop",
                "key": "shift+f5",
                "mac": "shift+f5",
                "when": "borielBasic.isDebugging"
            }
        ],
        "breakpoints": [
            {
                "language": "borielbasic"
            }
        ],
        "debuggers": [
            {
                "type": "borielbasic",
                "label": "Boriel Basic Debug",
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "emulator": {
                                "type": "string",
                                "enum": [
                                    "turbo80",
                                    "zesarux"
                                ],
                                "default": "turbo80",
                                "description": "Emulador a utilizar: turbo80 (integrado en webview) o zesarux (externo)."
                            },
                            "turbo80Model": {
                                "type": "string",
                                "enum": [
                                    "128k",
                                    "48k",
                                    "plus2",
                                    "plus2a",
                                    "plus3",
                                    "16k"
                                ],
                                "default": "128k",
                                "description": "Modelo de máquina ZX Spectrum para Turbo80 (128k, 48k, plus2, plus2a, plus3, 16k). Por defecto 128k."
                            },
                            "program": {
                                "type": "string",
                                "description": "Archivo TAP/TZX a cargar en el emulador (opcional para Turbo80 si se compila automáticamente).",
                                "default": "${workspaceFolder}/dist/main.tap"
                            },
                            "zesaruxPath": {
                                "type": "string",
                                "description": "Ruta al ejecutable de ZEsarUX (solo si emulator es zesarux).",
                                "default": "zesarux"
                            },
                            "debugPort": {
                                "type": "integer",
                                "description": "Puerto para el protocolo de depuración remota de ZEsarUX.",
                                "default": 10000
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Detener automáticamente al iniciar el programa en la primera línea de código.",
                                "default": true
                            },
                            "sourceFile": {
                                "type": "string",
                                "description": "Ruta al archivo .bas principal (relativa al workspaceFolder o absoluta). Si no se especifica se usa borielBasic.mainFile o el archivo activo.",
                                "default": "src/main.bas"
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "borielbasic",
                        "request": "launch",
                        "name": "Debug Boriel Basic (Turbo80)",
                        "emulator": "turbo80",
                        "turbo80Model": "128k",
                        "sourceFile": "src/main.bas",
                        "stopOnEntry": true
                    },
                    {
                        "type": "borielbasic",
                        "request": "launch",
                        "name": "Debug Boriel Basic (ZEsarUX)",
                        "emulator": "zesarux",
                        "program": "${workspaceFolder}\\dist\\main.tap",
                        "sourceFile": "src/main.bas",
                        "zesaruxPath": "zesarux",
                        "debugPort": 10000,
                        "stopOnEntry": false
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Boriel Basic: Debug Boriel Basic (Turbo80)",
                        "description": "Depurar programa Boriel Basic usando el emulador integrado Turbo80 en webview.",
                        "body": {
                            "type": "borielbasic",
                            "request": "launch",
                            "name": "Debug Boriel Basic (Turbo80)",
                            "emulator": "turbo80",
                            "turbo80Model": "128k",
                            "sourceFile": "src/main.bas",
                            "stopOnEntry": true
                        }
                    },
                    {
                        "label": "Boriel Basic: Debug Boriel Basic (ZEsarUX)",
                        "description": "Depurar programa Boriel Basic usando el emulador externo ZEsarUX.",
                        "body": {
                            "type": "borielbasic",
                            "request": "launch",
                            "name": "Debug Boriel Basic (ZEsarUX)",
                            "emulator": "zesarux",
                            "program": "${workspaceFolder}\\dist\\main.tap",
                            "sourceFile": "src/main.bas",
                            "zesaruxPath": "zesarux",
                            "debugPort": 10000,
                            "stopOnEntry": false
                        }
                    }
                ]
            }
        ]
    },
    "icon": "images/logo.jpg",
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0",
        "boriel-basic-lsp": "latest",
        "ignore": "^7.0.3",
        "vscode-languageclient": "^8.1.0"
    }
}