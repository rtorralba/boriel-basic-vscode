{
    "homepage": "https://github.com/rtorralba/boriel-basic-vscode#readme",
    "name": "boriel-basic",
    "displayName": "Boriel Basic",
    "description": "Programming language support for Boriel Basic, a BASIC compiler for the ZX Spectrum.",
    "version": "1.0.18",
    "author": "Raül Torralba (Juntelart)",
    "license": "MIT",
    "publisher": "rtorralba",
    "repository": {
        "type": "git",
        "url": "https://github.com/rtorralba/boriel-basic-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/rtorralba/boriel-basic-vscode/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:borielbasic",
        "onDebugResolve:borielbasic",
        "onDebugInitialConfigurations"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "borielbasic",
                "aliases": [
                    "Boriel Basic",
                    "boriel-basic"
                ],
                "extensions": [
                    ".bas",
                    ".zxbas"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "borielbasic",
                "scopeName": "source.borielbasic",
                "path": "./borielbasic.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Boriel Basic Configuration",
            "properties": {
                "borielBasic.mainFile": {
                    "type": "string",
                    "default": "main.bas",
                    "description": "Archivo principal del proyecto a compilar."
                },
                "borielBasic.optimizeLevel": {
                    "type": "integer",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 4,
                    "description": "Nivel de optimización (0-4)."
                },
                "borielBasic.outputFormat": {
                    "type": "string",
                    "default": "tap",
                    "enum": [
                        "tap",
                        "tzx"
                    ],
                    "description": "Formato de salida (tap o tzx)."
                },
                "borielBasic.autorun": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ejecutar automáticamente el programa después de compilar."
                },
                "borielBasic.org": {
                    "type": "integer",
                    "default": 32768,
                    "description": "Dirección ORG (inicio del código máquina)."
                },
                "borielBasic.includeBasicLoader": {
                    "type": "boolean",
                    "default": true,
                    "description": "Incluir el cargador BASIC en el programa."
                },
                "borielBasic.heapSize": {
                    "type": "integer",
                    "default": 4768,
                    "description": "Tamaño del HEAP en bytes."
                },
                "borielBasic.formatKeywords": {
                    "type": "boolean",
                    "default": false,
                    "description": "Si está activado, las palabras clave se formatearán"
                },
                "borielBasic.zesaruxPath": {
                    "type": "string",
                    "default": "zesarux",
                    "description": "Ruta al ejecutable de ZEsarUX."
                },
                "borielBasic.zesaruxRemoteDebugPort": {
                    "type": "integer",
                    "default": 10000,
                    "description": "Puerto para el protocolo de depuración remota de ZEsarUX."
                }
            }
        },
        "commands": [
            {
                "command": "borielBasic.compile",
                "title": "Compilar Boriel Basic",
                "category": "Boriel Basic"
            },
            {
                "command": "borielBasic.updateLSP",
                "title": "Actualizar Boriel Basic LSP",
                "category": "Boriel Basic"
            }
        ],
        "breakpoints": [
            {
                "language": "borielbasic"
            }
        ],
        "debuggers": [
            {
                "type": "borielbasic",
                "label": "Boriel Basic Debug",
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Archivo TAP/TZX a cargar en ZEsarUX.",
                                "default": "${workspaceFolder}/dist/main.tap"
                            },
                            "zesaruxPath": {
                                "type": "string",
                                "description": "Ruta al ejecutable de ZEsarUX.",
                                "default": "zesarux"
                            },
                            "debugPort": {
                                "type": "integer",
                                "description": "Puerto para el protocolo de depuración remota.",
                                "default": 10000
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Detener automáticamente al iniciar el programa.",
                                "default": true
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "borielbasic",
                        "request": "launch",
                        "name": "Debug con ZEsarUX",
                        "program": "${workspaceFolder}/dist/main.tap",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Boriel Basic: Debug con ZEsarUX",
                        "description": "Nueva configuración para depurar con ZEsarUX.",
                        "body": {
                            "type": "borielbasic",
                            "request": "launch",
                            "name": "Debug con ZEsarUX",
                            "program": "^\"\\${workspaceFolder}/dist/main.tap\"",
                            "stopOnEntry": true
                        }
                    }
                ]
            }
        ]
    },
    "icon": "images/logo.jpg",
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0",
        "boriel-basic-lsp": "^1.0.80",
        "ignore": "^7.0.3",
        "vscode-languageclient": "^8.1.0"
    }
}
